STORAGE_BACKEND=local
LOCAL_DB_PATH=data/pole.sqlite3
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=true
PRIMARY_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
FALLBACK_LLM_MODEL_1=google/gemini-2.0-flash-exp:free
FALLBACK_LLM_MODEL_2=qwen/qwen-2.5-72b-instruct:free
FALLBACK_LLM_MODEL_3=deepseek/deepseek-chat:free
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEED_DEMO=false
MAX_UPLOAD_MB=15
